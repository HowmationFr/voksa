{
  "name": "voksa",
  "productName": "Voksa",
  "version": "0.7.0",
  "description": "Voksa",
  "author": "Voksa",
  "license": "GPL-3.0-only",
  "repository": "github:HowmationFr/voksa",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "postinstall": "patch-package --error-on-fail --error-on-warn",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:ui && npm run build:main",
    "build:ui": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "gen:credits": "node scripts/gen-credits.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.16",
    "node-abi": "^4.40.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
